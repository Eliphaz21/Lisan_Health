# ==============================================================================
# LisanHealth Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO VERSION CONTROL.
# ==============================================================================

# TypeScript/Express application environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false
MAX_JSON_BYTES=1mb
MAX_UPLOAD_SIZE_BYTES=10485760
AUTH_RATE_LIMIT_MAX=10
RETENTION_HOURS=24

# Security & Authentication
SECRET_KEY=replace_with_a_secure_random_64_char_secret_for_jwt_tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_EMAIL=admin@example.com

# PostgreSQL configuration. Use a secret manager in production.
DATABASE_URL=postgresql://lisan_user:replace_me@localhost:5432/lisan_health_db?sslmode=require

# ------------------------------------------------------------------------------
# Dual-AI Pipeline Configuration
# ------------------------------------------------------------------------------

# AI providers. Never commit real values.
ADDIS_AI_BASE_URL=https://api.addisassistant.com
ADDIS_AI_TEXT_MODEL=addis-pro
ADDIS_AI_TIMEOUT_SECONDS=30
ADDIS_AI_TTS_ENABLED=true
ADDIS_AI_TTS_DEFAULT_VOICE_AM=am-hamen
ADDIS_AI_TTS_DEFAULT_VOICE_OM=om-bikila
ADDIS_AI_TTS_DEFAULT_VOICE_TI=ti-berhane
ADDIS_AI_TTS_DEFAULT_VOICE_EN=default
ADDIS_AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# DevOps & Observability
# ------------------------------------------------------------------------------
