# ==============================================================================
# LisanHealth Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# Security & Authentication
SECRET_KEY=replace_with_a_secure_random_64_char_secret_for_jwt_tokens
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Storage & Privacy Configuration
UPLOAD_DIR=./storage/uploads
AUDIO_OUTPUT_DIR=./storage/audio
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB limit
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg

# Database Configuration (PostgreSQL in production/Docker, SQLite in unit tests)
DATABASE_URL=postgresql://lisan_user:lisan_password@localhost:5432/lisan_health_db

# ------------------------------------------------------------------------------
# Dual-AI Pipeline Configuration
# ------------------------------------------------------------------------------

# AI Provider A: English Clinical Reasoning & Evidence Grounding
# Supported providers: mock, openai, gemini, groq
REASONING_PROVIDER=mock
REASONING_API_KEY=your_reasoning_provider_api_key_here
REASONING_MODEL=gemini-1.5-flash
REASONING_TIMEOUT_SECONDS=30
REASONING_MAX_RETRIES=2

# AI Provider B: Addis AI Ethiopian Localization & Speech
# Addis AI official documentation: https://docs.addisassistant.com
ADDIS_AI_BASE_URL=https://api.addisassistant.com/v1
ADDIS_AI_API_KEY=your_addis_ai_api_key_here
ADDIS_AI_TEXT_MODEL=addis-pro
ADDIS_AI_TIMEOUT_SECONDS=30
ADDIS_AI_MAX_RETRIES=2
ADDIS_AI_TTS_ENABLED=true
ADDIS_AI_STT_ENABLED=false
ADDIS_AI_TTS_DEFAULT_VOICE_AM=hanna
ADDIS_AI_TTS_DEFAULT_VOICE_OM=chala

# ------------------------------------------------------------------------------
# DevOps & Observability
# ------------------------------------------------------------------------------
PROMETHEUS_METRICS_ENABLED=true
METRICS_PORT=9090
